# Evalipie.in Aiven Infrastructure Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=evalipie-dev-secret-key-2026

# Aiven PostgreSQL (Source of Truth & ACID Checkout)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://avnadmin:your-password@your-pg-host.aivencloud.com:12345/defaultdb?sslmode=require

# Aiven Apache Kafka (Event Backbone & Transactional Outbox)
KAFKA_BROKERS=your-kafka-host.aivencloud.com:12345
KAFKA_CLIENT_ID=evalipie-stocksync
KAFKA_GROUP_ID=evalipie-consumer-group
# Provide either SSL CA cert string or paths to certs
KAFKA_SSL=true
KAFKA_CA_CERT=
KAFKA_ACCESS_CERT=
KAFKA_ACCESS_KEY=

# Aiven OpenSearch (Typo-Tolerant Discovery & Stock Faceting)
# Format: https://<user>:<password>@<host>:<port>
OPENSEARCH_NODE=https://avnadmin:your-password@your-opensearch-host.aivencloud.com:12345
OPENSEARCH_INDEX=evalipie_products

# Self-Hosted AI Intelligence Engine (Runs locally without external APIs)
AI_MODEL_PROVIDER=self_hosted
AI_MODEL_ID=qwen2.5:3b
AI_INFERENCE_BASE_URL=http://localhost:11434
