{
  "name": "evalipie-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "start": "npm run start --workspace=server",
    "test:concurrency": "npm run test:concurrency --workspace=server"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
